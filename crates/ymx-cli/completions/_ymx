#compdef ymx
#
# ymx zsh completion

_ymx() {
    local -a flags formats

    flags=(
        '--entry[Component name within file to compile]:component:'
        '--from-keyword[Override the from keyword]:keyword:'
        '--default-keyword[Override the $default keyword name]:keyword:'
        '--max-depth[Limit on template/call recursion]:n:'
        '--format[Output format]:format:(json compact diagnostics)'
        '--output[Write output to file instead of stdout]:file:_files'
        '--plain[Promote sub-namespace components and templates into global namespace]'
        '--plain-template[Promote sub-namespace templates only into global namespace]'
        '--test[Run inline _test cases instead of compiling]'
        '--help[Print help and exit]'
        '-h[Print help and exit]'
    )

    _arguments -s $flags '*:file:_files -g "*.yml" -g "*.yaml"'
}

_ymx "$@"
